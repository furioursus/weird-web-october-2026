---
/**
 * Shared shell for every day's page. It owns the plumbing (title, meta, Octothorpes tags,
 * self-hosted fonts, prev/next nav) and deliberately ships no visual styles, so each day can look
 * completely different. Put everything else in the page itself.
 */
import { Font } from "astro:assets";
import type { ComponentProps } from "astro/types";
import Seo from "@/components/Seo.astro";
import { CARD_HEIGHT, CARD_WIDTH, CARDS } from "@/data/cards";
import { DAYS, type Day as DayInfo, getDay, isReleased } from "@/data/days";
import { cssVariableFor, FONTS } from "@/fonts";

interface Props {
	/** Day of October, 1–31. The theme, slug and hashtag all come from this. */
	day: number;
	/** One line for search results and link previews. Falls back to the day and theme. */
	description?: string;
	/**
	 * Font families this page uses, e.g. ["Special Elite", "Inter"]. Each must be listed in
	 * src/fonts.ts. Use them in CSS as var(--font-special-elite), var(--font-inter), etc.
	 */
	fonts?: string[];
	/** Show the small prev / all / next nav. Turn it off when it fights the concept. */
	nav?: boolean;
}

const { day, fonts = [], nav = true } = Astro.props;
const { theme, slug } = getDay(day);
const description =
	Astro.props.description ??
	`Day ${day} of Weird Web October 2026, on the theme "${theme}". There's a cat hidden somewhere on it.`;
const built = new Set(
	Object.keys(import.meta.glob("../pages/[0-9][0-9]-*.astro")).map((path) =>
		path.replace(/^.*\//, "").replace(/\.astro$/, ""),
	),
);
const linkable = (d?: DayInfo) =>
	d && built.has(d.slug) && (import.meta.env.DEV || isReleased(d)) ? d : undefined;
const prev = linkable(DAYS[day - 2]);
const next = linkable(DAYS[day]);

// Astro only warns about fonts it can't find, so a typo would silently fall back to a system
// font. Fail the build instead.
type FontVariable = ComponentProps<typeof Font>["cssVariable"];
const fontVariables = fonts.map((name) => {
	if (!FONTS.some((f) => f.name === name)) {
		throw new Error(`Day ${day} uses font "${name}", which isn't listed in src/fonts.ts.`);
	}
	return cssVariableFor(name) as FontVariable;
});

const title = `${theme} · Weird Web October, Day ${day}`;
const card = CARDS[day];
const image = {
	src: `/${slug}/og.jpg`,
	alt: [
		`Day ${day} of Weird Web October, “${theme}”, beside a big ${day} on torn pink felt.`,
		[card?.title, card?.line].filter(Boolean).join(": "),
	]
		.filter(Boolean)
		.join(" "),
	width: CARD_WIDTH,
	height: CARD_HEIGHT,
	type: "image/jpeg",
};
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Seo title={title} description={description} image={image} />

		<!-- Octothorpes: lists this page under #weirdweboctober and the day's theme tag. -->
		<link rel="preload" as="fetch" href={`https://octothorp.es/?uri=${canonical}`} />
		<link rel="octo:octothorpes" href="weirdweboctober" />
		<link rel="octo:octothorpes" href={theme} />

		{fontVariables.map((cssVariable) => <Font cssVariable={cssVariable} preload />)}

		<slot name="head" />
	</head>
	<body>
		<slot />

		{nav && (
	<nav class="wwo-nav" aria-label="Weird Web October">
		{prev ? <a href={`/${prev.slug}/`}>← {prev.theme}</a> : <span />}
		<a href="/">all days</a>
		{next ? <a href={`/${next.slug}/`}>{next.theme} →</a> : <span />}
	</nav>
)}
	</body>
</html>

<style is:global>
/* :where() keeps specificity at zero, so any page can restyle or hide the nav. */
:where(.wwo-nav) {
	position: fixed;
	inset: auto 0.75rem 0.75rem auto;
	z-index: 2147483000;
	display: flex;
	gap: 0.75rem;
	font:
		12px / 1.2 ui-monospace,
		monospace;
	color: #fff;
	mix-blend-mode: difference;
}
:where(.wwo-nav a) {
	color: inherit;
}
</style>
