---
import HiddenCat from "@/components/HiddenCat.astro";
import Day from "@/layouts/Day.astro";

// Day 4: Plastic

const EGG =
	"M160 20C250 20 300 120 300 210C300 295 240 350 160 350C80 350 20 295 20 210C20 120 70 20 160 20Z";
const TYBALT =
	"M20 22 22 8l8 9h6l8-9 2 14c4 6 2 12-4 14 8 6 10 16 8 24H16c-2-8 0-18 8-24-6-2-8-8-4-14Z";
const SCREWS = [
	[48, 150],
	[272, 150],
	[96, 318],
	[224, 318],
];
const BUTTONS = [
	{ key: "a", x: 116, label: "A, next icon" },
	{ key: "b", x: 160, label: "B, choose" },
	{ key: "c", x: 204, label: "C, cancel" },
];
---

<Day
	day={4}
	description="Tybalgotchi: a translucent 1998 virtual pet whose cat skips the kibble to eat plastic, starting with the bread bag and ending with the toy itself."
	fonts={["Nunito", "Chewy"]}
>
	<main class="page">
		<header class="masthead">
			<h1 class="logo">Tybalgotchi<span class="logo__tm">™</span></h1>
			<p class="tagline">The virtual pet who will eat anything.<sup>*</sup></p>
			<p class="footnote"><sup>*</sup>Anything plastic. The food, he can take or leave.</p>
		</header>

		<section class="toy-area" aria-label="The Tybalgotchi">
			<div class="toy" data-state="off">
				<svg class="shell" viewBox="0 0 320 360" aria-hidden="true">
