							</g>
							<g fill="#c9a24a" opacity="0.8">
								<circle cx="148" cy="90" r="2.5" />
								<circle cx="184" cy="94" r="2.5" />
								<circle cx="70" cy="190" r="2.5" />
								<circle cx="252" cy="190" r="2.5" />
							</g>
							<circle cx="108" cy="62" r="20" fill="#c9a24a" opacity="0.9" />
							<circle cx="108" cy="62" r="13" fill="#e4dccb" opacity="0.85" />
