---
import HiddenCat from "@/components/HiddenCat.astro";
import Day from "@/layouts/Day.astro";

// Day 5: Sheet

const LETTERS = [..."ABCDEFGHIJKLMNOPQRST"];
const ROWS = Array.from({ length: 50 }, (_, i) => i + 1);
const CAT_CELL = "R44";
---

<Day
	day={5}
	description="Cellmates: a perfectly ordinary spreadsheet whose cells have feelings. Sort them and they hop into line."
	fonts={["Instrument Sans", "Fredoka"]}
>
	<div class="app">
		<header class="topbar">
			<div class="brand">
				<span class="logo" aria-hidden="true"><i></i><i></i><b></b></span>
				<span class="brand-name">Cellmates</span>
			</div>
			<div class="file">
				<h1>Snack budget</h1>
				<p class="saved">All changes saved. Everyone's fine.</p>
			</div>
		</header>

		<div class="toolbar" role="toolbar" aria-label="Sheet tools">
			<button type="button" data-action="sort-asc">Sort A→Z</button>
			<button type="button" data-action="sort-desc">Sort Z→A</button>
			<button type="button" data-action="autosum">Σ Sum</button>
			<p class="toast" aria-live="polite"></p>
		</div>

		<div class="formula-bar">
			<span class="ref-box">D10</span>
			<span class="fx" aria-hidden="true">fx</span>
			<span class="raw"></span>
		</div>

		<div class="scroller">
			<div
				class="grid"
				role="grid"
				tabindex="0"
				aria-label="Snack budget"
				aria-rowcount={ROWS.length}
				aria-colcount={LETTERS.length}
			>
				<div class="row" role="row">
					<div class="corner" role="columnheader"></div>
					{LETTERS.map((letter) => <div class="colhead" role="columnheader">{letter}</div>)}
				</div>
				{ROWS.map((r) => (
						<div class="row" role="row">
							<div class="rowhead" role="rowheader">
								{r}
							</div>
							{LETTERS.map((letter) => (
								<div class="cell" role="gridcell" id={`c-${letter}${r}`} data-ref={`${letter}${r}`}>
									{`${letter}${r}` === CAT_CELL && (
										<HiddenCat cat="dante" day={5} size={26} color="#7a5535" absolute={false} />
									)}
								</div>
							))}
						</div>
					))}
				<div class="cursor" aria-hidden="true"><span class="handle"></span></div>
				<div class="fill-preview" aria-hidden="true" hidden></div>
				<input class="editor" type="text" aria-label="Edit cell" hidden />
			</div>
		</div>
		<p class="status" aria-live="polite"></p>
	</div>
</Day>

<script>
	type Mood = "happy" | "proud" | "shy" | "worried" | "sleepy" | "giddy" | "clever" | "dizzy";
	interface Entry {
		raw: string;
		id: number;
	}
	interface Critter {
		el: HTMLElement;
		val: HTMLElement;
		id: number;
		shown: string;
	}

	class Err {
		code: string;
		constructor(code: string) {
			this.code = code;
		}
	}
	type Val = number | string | Err;

	const COLS = 20;
	const ROWS = 50;
	const ROW_H = 36;
	const RAND_EVERY = 1800;
	const BLINK_EVERY = 6000;
	const BLINK_TICK = 250;
	const MOOD_WORDS: Record<Mood, string> = {
		happy: "content",
		proud: "very proud",
		shy: "a little shy",
		worried: "worried",
		sleepy: "asleep",
		giddy: "giddy",
		clever: "pleased with itself",
		dizzy: "dizzy",
	};
	const START: Record<string, string> = {
		A1: "Snack",
		B1: "Qty",
		C1: "Price",
		D1: "Cost",
		A2: "Pretzels",
		B2: "4",
		C2: "3.25",
		A3: "Seaweed",
		B3: "12",
		C3: "1.1",
		A4: "Gummy bears",
		B4: "3",
		C4: "2.75",
		A5: "Clementines",
		B5: "20",
		C5: "0.4",
		A6: "Rice crackers",
		B6: "5",
		C6: "2.2",
		A7: "Mystery bag",
		B7: "1",
		C7: "=ROUND(RAND()*9+1, 2)",
		A8: "Fancy cheese",
		B8: "0",
		C8: "6.5",
		A10: "Total",
		D10: "=SUM(D2:D8)",
		A11: "Avg. price",
		C11: "=AVERAGE(C2:C8)",
	};
	for (let r = 2; r <= 8; r++) START[`D${r}`] = `=B${r}*C${r}`;

	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const grid = document.querySelector<HTMLElement>(".grid");
	const scroller = document.querySelector<HTMLElement>(".scroller");
	const cursor = document.querySelector<HTMLElement>(".cursor");
	const handle = document.querySelector<HTMLElement>(".handle");
	const preview = document.querySelector<HTMLElement>(".fill-preview");
	const editor = document.querySelector<HTMLInputElement>(".editor");
	const refBox = document.querySelector<HTMLElement>(".ref-box");
	const rawBox = document.querySelector<HTMLElement>(".raw");
	const toast = document.querySelector<HTMLElement>(".toast");
	const status = document.querySelector<HTMLElement>(".status");

	const sheet = new Map<string, Entry>();
	const values = new Map<string, Val>();
	const critters = new Map<string, Critter>();
	let nextId = 1;
	let sel = { c: 3, r: 10 };
	let pointer: { x: number; y: number } | null = null;
	let fans = new Set<string>();

	const letter = (c: number) => String.fromCharCode(65 + c);
	const refOf = (c: number, r: number) => `${letter(c)}${r}`;
	function parseRef(ref: string) {
		const m = /^\$?([A-Z])\$?(\d+)$/.exec(ref);
		if (!m) return null;
		const c = (m[1] ?? "A").charCodeAt(0) - 65;
		const r = Number(m[2]);
		return c >= 0 && c < COLS && r >= 1 && r <= ROWS ? { c, r } : null;
	}
	function expand(range: string) {
		const [from, to] = range.split(":");
		const a = parseRef(from ?? "");
		const b = parseRef(to ?? from ?? "");
		if (!a || !b) throw new Err("#REF!");
		const refs: string[] = [];
		for (let r = Math.min(a.r, b.r); r <= Math.max(a.r, b.r); r++) {
			for (let c = Math.min(a.c, b.c); c <= Math.max(a.c, b.c); c++) refs.push(refOf(c, r));
		}
		return refs;
	}
	const cellEl = (ref: string) => document.getElementById(`c-${ref}`);

	function compute(ref: string, seen: Set<string>): Val {
		const cached = values.get(ref);
		if (cached !== undefined) return cached;
		const raw = sheet.get(ref)?.raw ?? "";
		let v: Val;
		if (!raw.startsWith("=")) {
			const t = raw.trim();
			v = t !== "" && Number.isFinite(Number(t)) ? Number(t) : raw;
		} else if (seen.has(ref)) {
			return new Err("#CIRC!");
		} else {
			seen.add(ref);
			try {
				v = run(raw.slice(1), seen);
			} catch (e) {
				v = e instanceof Err ? e : new Err("#ERROR!");
			}
			seen.delete(ref);
		}
		values.set(ref, v);
		return v;
	}

	function run(src: string, seen: Set<string>): number {
		const pattern = /\$?[A-Z]+\$?\d+(?::\$?[A-Z]+\$?\d+)?|[A-Z]+|\d+(?:\.\d+)?|[-+*/(),]/g;
		const tokens = src.toUpperCase().match(pattern) ?? [];
		if (tokens.join("") !== src.toUpperCase().replace(/\s+/g, "")) throw new Err("#ERROR!");
		let i = 0;
		const peek = () => tokens[i];
		const next = () => tokens[i++];
		const expect = (t: string) => {
			if (next() !== t) throw new Err("#ERROR!");
		};
		const num = (ref: string) => {
			if (!parseRef(ref)) throw new Err("#REF!");
			const v = compute(ref.replace(/\$/g, ""), seen);
			if (v instanceof Err) throw v;
			if (v === "") return 0;
			if (typeof v === "string") throw new Err("#VALUE!");
			return v;
		};
		const rangeValues = (range: string) => {
			const out: number[] = [];
			for (const ref of expand(range.replace(/\$/g, ""))) {
				const v = compute(ref, seen);
				if (v instanceof Err) throw v;
				if (typeof v === "number") out.push(v);
			}
			return out;
		};
		const call = (name: string, args: number[]) => {
			const sum = args.reduce((a, b) => a + b, 0);
			switch (name) {
				case "SUM":
					return sum;
				case "AVERAGE":
					if (!args.length) throw new Err("#DIV/0!");
					return sum / args.length;
				case "MIN":
					return args.length ? Math.min(...args) : 0;
				case "MAX":
					return args.length ? Math.max(...args) : 0;
				case "COUNT":
					return args.length;
				case "ROUND": {
					const places = 10 ** (args[1] ?? 0);
					return Math.round((args[0] ?? 0) * places) / places;
				}
				case "RAND":
					return Math.random();
				default:
					throw new Err("#NAME?");
			}
		};
		function factor(): number {
			const t = next();
			if (t === undefined) throw new Err("#ERROR!");
			if (t === "-") return -factor();
			if (t === "(") {
				const v = expr();
				expect(")");
				return v;
			}
			if (/^\d/.test(t)) return Number(t);
			if (/^[A-Z]+$/.test(t)) {
				expect("(");
				const args: number[] = [];
				while (peek() !== ")") {
					const arg = peek() ?? "";
					if (arg.includes(":")) {
						next();
						args.push(...rangeValues(arg));
					} else {
						args.push(expr());
					}
					if (peek() === ",") next();
					else break;
				}
				expect(")");
				return call(t, args);
			}
			if (t.includes(":")) throw new Err("#VALUE!");
			return num(t);
		}
		function term(): number {
			let v = factor();
			while (peek() === "*" || peek() === "/") {
				const op = next();
				const r = factor();
				if (op === "/" && r === 0) throw new Err("#DIV/0!");
				v = op === "*" ? v * r : v / r;
			}
			return v;
		}
		function expr(): number {
			let v = term();
			while (peek() === "+" || peek() === "-") {
				const op = next();
				const r = term();
				v = op === "+" ? v + r : v - r;
			}
			return v;
		}
		const v = expr();
		if (i < tokens.length) throw new Err("#ERROR!");
		return v;
	}

	function shiftRefs(raw: string, dr: number, dc: number) {
		if (!raw.startsWith("=")) return raw;
		return raw.replace(
			/(\$?)([A-Z])(\$?)(\d+)/g,
			(_, cAbs: string, col: string, rAbs: string, row: string) => {
				const c = col.charCodeAt(0) - 65 + (cAbs ? 0 : dc);
				const r = Number(row) + (rAbs ? 0 : dr);
				if (c < 0 || c >= COLS || r < 1 || r > ROWS) return "#REF!";
				return `${cAbs}${letter(c)}${rAbs}${r}`;
			},
		);
	}

	const show = (v: Val) =>
		v instanceof Err
			? v.code
			: typeof v === "number"
				? Number.isInteger(v)
					? String(v)
					: v.toFixed(2)
				: v;

	function recompute() {
		values.clear();
		for (const ref of sheet.keys()) compute(ref, new Set());
		const stats = new Map<number, number[]>();
		for (const [ref, v] of values) {
			const pos = parseRef(ref);
			if (!pos || typeof v !== "number") continue;
			stats.set(pos.c, [...(stats.get(pos.c) ?? []), v]);
		}
		return stats;
	}

	function moodOf(ref: string, v: Val, stats: Map<number, number[]>): Mood {
		const raw = sheet.get(ref)?.raw ?? "";
		if (v instanceof Err) return "dizzy";
		if (/RAND\(/i.test(raw)) return "giddy";
		if (typeof v === "string") return "happy";
		if (v < 0) return "worried";
		if (v === 0) return "sleepy";
		const column = stats.get(parseRef(ref)?.c ?? -1) ?? [];
		if (column.length >= 3 && v === Math.max(...column)) return "proud";
		if (column.length >= 3 && v === Math.min(...column)) return "shy";
		if (raw.startsWith("=")) return "clever";
		return "happy";
	}

	function makeCritter(ref: string, id: number): Critter | null {
		const cell = cellEl(ref);
		if (!cell) return null;
		const el = document.createElement("span");
		el.className = "critter";
		const val = document.createElement("span");
		val.className = "val";
		const face = document.createElement("span");
		face.className = "face";
		face.setAttribute("aria-hidden", "true");
		face.innerHTML = '<i class="eye"></i><i class="eye"></i><i class="mouth"></i>';
		el.append(face, val);
		cell.append(el);
		return { el, val, id, shown: "" };
	}

	function setStyle(el: HTMLElement, name: string, value: string) {
		if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value);
	}

	function play(el: HTMLElement, name: string, delay = 0) {
		if (reduce) return;
		window.setTimeout(() => {
			if (el.classList.contains(name)) {
				el.classList.remove(name);
				void el.offsetWidth;
			}
			el.classList.add(name);
			const done = (e: AnimationEvent) => {
				if (e.target !== el) return;
				el.classList.remove(name);
				el.removeEventListener("animationend", done);
			};
			el.addEventListener("animationend", done);
		}, delay);
	}

	/** Redraws every cell. `origin` is where a change started, so value changes ripple out from it. */
	function render(origin?: string, quiet = false) {
		const stats = recompute();
		const from = origin ? parseRef(origin) : null;
		for (const [ref, entry] of sheet) {
			let critter = critters.get(ref);
			const fresh = !critter || critter.id !== entry.id;
			if (critter && critter.id !== entry.id) {
				critter.el.remove();
				critter = undefined;
			}
			if (!critter) {
				const made = makeCritter(ref, entry.id);
				if (!made) continue;
				critter = made;
				critters.set(ref, critter);
			}
			const v = values.get(ref) ?? "";
			const text = show(v);
			const changed = critter.shown !== "" && critter.shown !== text;
			if (critter.val.textContent !== text) critter.val.textContent = text;
			critter.el.classList.toggle("num", typeof v === "number" || v instanceof Err);
			const mood = moodOf(ref, v, stats);
			if (critter.el.dataset.mood !== mood) critter.el.dataset.mood = mood;
			if (changed && !fresh && !quiet) {
				const pos = parseRef(ref);
				const dist = from && pos ? Math.abs(pos.c - from.c) + Math.abs(pos.r - from.r) : 0;
				play(critter.el, "oh", Math.min(600, dist * 45));
			}
			critter.shown = text;
		}
		for (const [ref, critter] of critters) {
			if (sheet.has(ref)) continue;
			critters.delete(ref);
			if (reduce) {
				critter.el.remove();
			} else {
				critter.el.dataset.mood = "sleepy";
				critter.el.classList.add("leaving");
				critter.el.addEventListener("animationend", () => critter.el.remove(), { once: true });
			}
		}
		select(sel.c, sel.r, false);
	}

	function setRaw(ref: string, raw: string) {
		const clean = raw.startsWith("=") ? raw.toUpperCase() : raw;
		if (!clean.trim()) {
			sheet.delete(ref);
			return;
		}
		const existing = sheet.get(ref);
		sheet.set(ref, { raw: clean, id: existing?.id ?? nextId++ });
	}

	function precedents(raw: string) {
		const out = new Set<string>();
		if (!raw.startsWith("=")) return out;
		for (const m of raw.matchAll(/\$?[A-Z]\$?\d+(?::\$?[A-Z]\$?\d+)?/g)) {
			try {
				for (const ref of expand(m[0].replace(/\$/g, ""))) out.add(ref);
			} catch {
				// A broken reference has nobody to look at.
			}
		}
		return out;
	}

	function say(text: string) {
		if (status) status.textContent = text;
	}

	function select(c: number, r: number, announce = true) {
		sel = { c: Math.max(0, Math.min(COLS - 1, c)), r: Math.max(1, Math.min(ROWS, r)) };
		const ref = refOf(sel.c, sel.r);
		const cell = cellEl(ref);
		if (!cell || !cursor || !grid) return;
		setStyle(cursor, "translate", `${cell.offsetLeft - 1}px ${cell.offsetTop - 1}px`);
		setStyle(cursor, "inline-size", `${cell.offsetWidth + 1}px`);
		setStyle(cursor, "block-size", `${cell.offsetHeight + 1}px`);
		grid.setAttribute("aria-activedescendant", cell.id);
		const raw = sheet.get(ref)?.raw ?? "";
		if (refBox) refBox.textContent = ref;
		if (rawBox) rawBox.textContent = raw;

		for (const fan of fans) cellEl(fan)?.classList.remove("fan");
		fans = precedents(raw);
		for (const fan of fans) cellEl(fan)?.classList.add("fan");

		for (const [other, critter] of critters) {
			const pos = parseRef(other);
			if (!pos) continue;
			const dx = sel.c - pos.c;
			const dy = sel.r - pos.r;
			const near = Math.max(Math.abs(dx), Math.abs(dy)) === 1;
			critter.el.classList.toggle("lean", near && !reduce);
			setStyle(critter.el, "--dx", String(Math.sign(dx)));
			setStyle(critter.el, "--dy", String(Math.sign(dy)));
		}
		lookAround();

		if (announce) {
			const v = values.get(ref);
			const mood = critters.get(ref)?.el.dataset.mood as Mood | undefined;
			if (ref === "R44") say("R44. Something is curled up in here.");
			else if (v === undefined || !mood) say(`${ref}, empty.`);
			else say(`${ref}, ${show(v)}, ${MOOD_WORDS[mood]}.`);
			cell.scrollIntoView({ block: "nearest", inline: "nearest" });
		}
	}

	let lookQueued = false;
	function lookAround() {
		if (lookQueued) return;
		lookQueued = true;
		requestAnimationFrame(() => {
			lookQueued = false;
			const selected = cellEl(refOf(sel.c, sel.r))?.getBoundingClientRect();
			const selPoint = selected
				? { x: selected.left + selected.width / 2, y: selected.top + selected.height / 2 }
				: null;
			// Every read before any write; see docs/days/05-sheet.md (scroll performance).
			const faces = [...critters].map(([ref, critter]) => ({
				ref,
				critter,
				face: critter.el.firstElementChild?.getBoundingClientRect(),
			}));
			for (const { ref, critter, face } of faces) {
				const target = fans.has(ref) ? selPoint : (pointer ?? selPoint);
				if (!target || !face) continue;
				const dx = target.x - (face.left + face.width / 2);
				const dy = target.y - (face.top + face.height / 2);
				const len = Math.hypot(dx, dy) || 1;
				setStyle(critter.el, "--lx", `${((dx / len) * 1.4).toFixed(2)}px`);
				setStyle(critter.el, "--ly", `${((dy / len) * 1.2).toFixed(2)}px`);
			}
		});
	}

	function startEdit(initial?: string) {
		const ref = refOf(sel.c, sel.r);
		const cell = cellEl(ref);
		if (!editor || !cell) return;
		editor.hidden = false;
		editor.style.translate = `${cell.offsetLeft}px ${cell.offsetTop}px`;
		editor.style.inlineSize = `${cell.offsetWidth}px`;
		editor.style.blockSize = `${cell.offsetHeight}px`;
		editor.value = initial ?? sheet.get(ref)?.raw ?? "";
		editor.dataset.ref = ref;
		editor.focus();
	}

	function stopEdit(commit: boolean) {
		if (!editor || editor.hidden) return;
		const ref = editor.dataset.ref ?? "";
		editor.hidden = true;
		if (commit && ref) {
			const was = sheet.has(ref);
			setRaw(ref, editor.value);
			render(ref);
			const critter = critters.get(ref);
			if (critter && !was) play(critter.el, "hatch");
		}
		grid?.focus();
	}

	function clearCell() {
		const ref = refOf(sel.c, sel.r);
		if (!sheet.has(ref)) return;
		sheet.delete(ref);
		render(ref);
		say(`${ref} tucked in for the night.`);
	}

	function tableBounds() {
		let width = 0;
		while (width < COLS && sheet.has(refOf(width, 1))) width++;
		let last = 1;
		while (last < ROWS) {
			const row = last + 1;
			let filled = false;
			for (let c = 0; c < width; c++) if (sheet.has(refOf(c, row))) filled = true;
			if (!filled) break;
			last = row;
		}
		return { width, last };
	}

	let toastTimer = 0;
	function flash(text: string) {
		if (!toast) return;
		toast.textContent = text;
		window.clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => {
			toast.textContent = "";
		}, 3200);
	}

	function sortBy(col: number, dir: 1 | -1) {
		const { width, last } = tableBounds();
		if (col >= width || last < 3) {
			flash("Pick a column inside the table first.");
			return;
		}
		const rows: { r: number; entries: (Entry | undefined)[]; key: Val | undefined }[] = [];
		for (let r = 2; r <= last; r++) {
			const entries: (Entry | undefined)[] = [];
			for (let c = 0; c < width; c++) entries.push(sheet.get(refOf(c, r)));
			rows.push({ r, entries, key: values.get(refOf(col, r)) });
		}
		const rank = (v: Val | undefined) =>
			typeof v === "number" ? 0 : typeof v === "string" && v !== "" ? 1 : 2;
		const sorted = [...rows].sort((a, b) => {
			const ra = rank(a.key);
			const rb = rank(b.key);
			if (ra !== rb) return ra - rb;
			if (typeof a.key === "number" && typeof b.key === "number") return (a.key - b.key) * dir;
			return String(a.key ?? "").localeCompare(String(b.key ?? "")) * dir;
		});
		const already = sorted.every((row, i) => row.r === i + 2);

		const before = new Map<number, { x: number; y: number }>();
		for (const [ref, critter] of critters) {
			const cell = cellEl(ref);
			if (cell) before.set(critter.id, { x: cell.offsetLeft, y: cell.offsetTop });
		}
		sorted.forEach((row, i) => {
			const to = i + 2;
			row.entries.forEach((entry, c) => {
				const ref = refOf(c, to);
				if (entry) sheet.set(ref, { raw: shiftRefs(entry.raw, to - row.r, 0), id: entry.id });
				else sheet.delete(ref);
			});
		});
		// Cellmates keep their identity through a sort, so their nodes move with their entries.
		const homes = new Map<number, string>();
		for (const [ref, entry] of sheet) homes.set(entry.id, ref);
		const moved = [...critters.values()];
		critters.clear();
		for (const critter of moved) {
			const home = homes.get(critter.id);
			if (!home) continue;
			critters.set(home, critter);
			cellEl(home)?.append(critter.el);
		}
		render(undefined, true);

		if (!reduce) {
			for (const [ref, critter] of critters) {
				const was = before.get(critter.id);
				const cell = cellEl(ref);
				if (!was || !cell) continue;
				const dx = was.x - cell.offsetLeft;
				const dy = was.y - cell.offsetTop;
				if (!dx && !dy) continue;
				const lift = Math.min(26, 8 + Math.abs(dy) / 10);
				critter.el.animate(
					[
						{ translate: `${dx}px ${dy}px` },
						{ translate: `${dx / 2}px ${dy / 2 - lift}px`, offset: 0.5 },
						{ translate: "0 0" },
					],
					{
						duration: 560,
						easing: "cubic-bezier(.35,.1,.3,1)",
						delay: (ref.charCodeAt(0) - 65) * 30,
					},
				);
			}
			for (let r = 2; r <= last; r++) {
				const critter = critters.get(refOf(col, r));
				if (critter) play(critter.el, "cheer", (already ? 0 : 620) + (r - 2) * 70);
			}
		}
		const name = show(values.get(refOf(col, 1)) ?? letter(col));
		flash(
			already
				? "Already in order. They lined up anyway."
				: `Sorted by ${name}, ${dir === 1 ? "smallest" : "biggest"} first.`,
		);
	}

	function autosum() {
		let top = sel.r - 1;
		while (top >= 1 && typeof values.get(refOf(sel.c, top)) === "number") top--;
		if (top === sel.r - 1) {
			flash("Nothing above to add up.");
			return;
		}
		const ref = refOf(sel.c, sel.r);
		const was = sheet.has(ref);
		setRaw(ref, `=SUM(${refOf(sel.c, top + 1)}:${refOf(sel.c, sel.r - 1)})`);
		render(ref);
		const critter = critters.get(ref);
		if (critter && !was) play(critter.el, "hatch");
	}

	let fill: { col: number; from: number; to: number } | null = null;
	function fillTo(row: number) {
		if (!fill || !preview) return;
		fill.to = Math.max(fill.from, Math.min(ROWS, row));
		const top = cellEl(refOf(fill.col, fill.from + 1));
		const bottom = cellEl(refOf(fill.col, fill.to));
		preview.hidden = fill.to === fill.from || !top || !bottom;
		if (top && bottom) {
			preview.style.translate = `${top.offsetLeft - 1}px ${top.offsetTop - 1}px`;
			preview.style.inlineSize = `${top.offsetWidth + 1}px`;
			preview.style.blockSize = `${bottom.offsetTop + bottom.offsetHeight - top.offsetTop + 1}px`;
		}
	}

	function finishFill() {
		if (!fill || !preview) return;
		const { col, from, to } = fill;
		fill = null;
		preview.hidden = true;
		const source = sheet.get(refOf(col, from));
		if (!source || to === from) return;
		const n = Number(source.raw);
		const isNumber = source.raw.trim() !== "" && Number.isFinite(n);
		for (let k = 1; k <= to - from; k++) {
			const raw = isNumber ? String(n + k) : shiftRefs(source.raw, k, 0);
			sheet.set(refOf(col, from + k), { raw, id: nextId++ });
		}
		render(refOf(col, from));
		for (let k = 1; k <= to - from; k++) {
			const critter = critters.get(refOf(col, from + k));
			if (!critter || reduce) continue;
			critter.el.animate(
				[
					{ translate: `0 ${-k * ROW_H}px`, scale: "0.6" },
					{ translate: `0 ${-k * ROW_H * 0.5 - 10}px`, scale: "1", offset: 0.6 },
					{ translate: "0 0", scale: "1" },
				],
				{ duration: 420, easing: "ease-out", delay: k * 90, fill: "backwards" },
			);
		}
		flash(to - from === 1 ? "A new cellmate!" : `${to - from} new cellmates, in a line.`);
	}

	if (grid && scroller && editor && handle) {
		for (const [ref, raw] of Object.entries(START)) setRaw(ref, raw);
		render();

		grid.addEventListener("pointerdown", (e) => {
			const target = e.target as HTMLElement;
			if (target.closest(".handle, .editor, .wwo-cat")) return;
			const cell = target.closest<HTMLElement>(".cell");
			const pos = cell ? parseRef(cell.dataset.ref ?? "") : null;
			if (!pos) return;
			stopEdit(true);
			select(pos.c, pos.r);
		});
		grid.addEventListener("dblclick", (e) => {
			if ((e.target as HTMLElement).closest(".cell")) startEdit();
		});

		window.addEventListener("pointermove", (e) => {
			if (fill) {
				const cell = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>(".cell");
				const pos = cell ? parseRef(cell.dataset.ref ?? "") : null;
				if (pos) fillTo(pos.r);
			}
			if (e.pointerType === "touch") return;
			pointer = { x: e.clientX, y: e.clientY };
			lookAround();
		});
		document.documentElement.addEventListener("pointerleave", () => {
			pointer = null;
			lookAround();
		});
		scroller.addEventListener(
			"scroll",
			() => {
				if (pointer) lookAround();
			},
			{ passive: true },
		);

		handle.addEventListener("pointerdown", (e) => {
			e.preventDefault();
			e.stopPropagation();
			handle.setPointerCapture(e.pointerId);
			fill = { col: sel.c, from: sel.r, to: sel.r };
		});
		handle.addEventListener("pointerup", finishFill);
		handle.addEventListener("pointercancel", () => {
			fill = null;
			if (preview) preview.hidden = true;
		});

		grid.addEventListener("keydown", (e) => {
			if (e.target === editor) return;
			const moves: Record<string, [number, number]> = {
				ArrowLeft: [-1, 0],
				ArrowRight: [1, 0],
				ArrowUp: [0, -1],
				ArrowDown: [0, 1],
			};
			const move = moves[e.key];
			if (move) {
				e.preventDefault();
				if (e.shiftKey && move[1] > 0 && sheet.has(refOf(sel.c, sel.r))) {
					fill = { col: sel.c, from: sel.r, to: sel.r };
					fillTo(sel.r + 1);
					finishFill();
					return;
				}
				select(sel.c + move[0], sel.r + move[1]);
			} else if (e.key === "Enter" || e.key === "F2") {
				e.preventDefault();
				startEdit();
			} else if (e.key === "Delete" || e.key === "Backspace") {
				e.preventDefault();
				clearCell();
			} else if (e.key === "Tab") {
				e.preventDefault();
				select(sel.c + (e.shiftKey ? -1 : 1), sel.r);
			} else if (e.key.length === 1 && !e.metaKey && !e.ctrlKey && !e.altKey) {
				e.preventDefault();
				startEdit(e.key);
			}
		});

		editor.addEventListener("keydown", (e) => {
			if (e.key === "Enter") {
				e.preventDefault();
				stopEdit(true);
				select(sel.c, sel.r + 1);
			} else if (e.key === "Tab") {
				e.preventDefault();
				stopEdit(true);
				select(sel.c + (e.shiftKey ? -1 : 1), sel.r);
			} else if (e.key === "Escape") {
				e.preventDefault();
				stopEdit(false);
			}
		});
		editor.addEventListener("blur", () => stopEdit(true));

		for (const button of document.querySelectorAll<HTMLButtonElement>(".toolbar button")) {
			button.addEventListener("click", () => {
				const action = button.dataset.action;
				if (action === "sort-asc") sortBy(sel.c, 1);
				else if (action === "sort-desc") sortBy(sel.c, -1);
				else if (action === "autosum") autosum();
			});
		}

		window.setInterval(() => {
			const giddy = [...sheet].find(([, entry]) => /RAND\(/.test(entry.raw))?.[0];
			if (!giddy) return;
			render(giddy);
			const critter = critters.get(giddy);
			if (critter) play(critter.el, "jiggle");
		}, RAND_EVERY);

		window.setInterval(() => {
			if (reduce) return;
			for (const critter of critters.values()) {
				if (Math.random() >= BLINK_TICK / BLINK_EVERY) continue;
				critter.el.classList.add("blink");
				window.setTimeout(() => critter.el.classList.remove("blink"), 300);
			}
		}, BLINK_TICK);
	}
</script>

