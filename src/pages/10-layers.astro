---
import HiddenCat from "@/components/HiddenCat.astro";
import Day from "@/layouts/Day.astro";

// Day 10: Layers

const ERAS = [
	{ id: "canvas", depth: 0, tag: "<html>" },
	{ id: "y1997", depth: 1, tag: "1997 · brightpath.html" },
	{ id: "y2001", depth: 2, tag: "2001 · table#layout" },
	{ id: "y2008", depth: 3, tag: "2008 · div.web20" },
	{ id: "y2014", depth: 4, tag: "2014 · .jumbotron" },
	{ id: "y2026", depth: 5, tag: "2026 · <main>" },
];
const tagFor = (id: string) => ERAS.find((era) => era.id === id)?.tag ?? id;
const depthFor = (id: string) => ERAS.find((era) => era.id === id)?.depth ?? 0;
---

<Day
	day={10}
	description="A perfectly bland company website. Drag it sideways and every redesign since 1997 is still under there."
	fonts={["Inter", "Open Sans"]}
>
	<div class="stage" id="stage">
		<div class="stack" id="stack">
			<section
				class="layer canvas"
				style={`--depth: ${depthFor("canvas")}`}
				aria-label="The bare page"
			>
				<span class="tag">{tagFor("canvas")}</span>
				<p class="canvas__dust">nothing here but dust</p>
				<div class="canvas__nap">
					<HiddenCat cat="dante" day={10} size={78} color="#6b4a2f" style="bottom: 0; right: 0;" />
					<span class="canvas__zzz" aria-hidden="true">z z z</span>
				</div>
			</section>

			<section
				class="layer y1997"
				style={`--depth: ${depthFor("y1997")}`}
				aria-label="The 1997 site"
			>
				<span class="tag">{tagFor("y1997")}</span>
				<div class="y1997__marquee">
					<span>~*~ Welcome to Bright Path's Home Page!!! ~*~ Thanx for stopping by ~*~</span>
				</div>
				<h2 class="y1997__title">BRIGHT PATH</h2>
				<p class="y1997__under">🚧 UNDER CONSTRUCTION 🚧</p>
				<hr class="y1997__rainbow" />
				<p>
					Hi!! This is the official web site of Bright Path. We do consulting and stuff.
					<span class="y1997__new">NEW!</span>
				</p>
				<p>
					<span class="link">Sign my Guestbook</span>
					· <span class="link">Cool Links</span> · <span class="link">Webring ⇄</span>
				</p>
				<p class="y1997__counter">You are visitor # <span>000417</span></p>
				<p class="y1997__small">Best viewed in Netscape Navigator 3.0 at 640×480</p>
			</section>

			<section
				class="layer y2001"
				style={`--depth: ${depthFor("y2001")}`}
				aria-label="The 2001 site"
			>
				<span class="tag">{tagFor("y2001")}</span>
				<div class="y2001__banner">BrightPath Consulting Group, Inc.</div>
				<div class="y2001__body">
					<nav class="y2001__nav">
						<span class="link">» Home</span>
						<span class="link">» About Us</span>
						<span class="link">» Services</span>
						<span class="link">» Our Team</span>
						<span class="link">» Contact</span>
					</nav>
					<div class="y2001__main">
						<h2>Welcome to our web site!</h2>
						<p>
							BrightPath Consulting Group delivers e-business solutions for the new economy. Click
							on a link at left to learn more about our services.
						</p>
						<p class="y2001__spacer" title="spacer.gif">[spacer.gif]</p>
						<p class="y2001__small">
							Best viewed in Internet Explorer 5.5 at 800×600 · Last updated 3/14/2001
						</p>
					</div>
				</div>
			</section>

			<section
				class="layer y2008"
				style={`--depth: ${depthFor("y2008")}`}
				aria-label="The 2008 site"
			>
				<span class="tag">{tagFor("y2008")}</span>
				<header class="y2008__header">
					<span class="y2008__logo">BrightPath<sup>2.0</sup></span>
					<span class="y2008__beta">BETA</span>
				</header>
				<div class="y2008__hero">
					<h2>Collaborate. Share. Synergize!</h2>
					<p>Your team's new social workspace. Now with RSS!</p>
