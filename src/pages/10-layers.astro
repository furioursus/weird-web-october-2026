			</section>

			<aside class="floater sticky" style="--depth: 4.5" aria-label="A sticky note">
				TODO: delete old sites before launch!!
			</aside>

			<section
				class="layer y2026"
				style={`--depth: ${depthFor("y2026")}`}
				aria-label="The current site"
			>
				<span class="tag">{tagFor("y2026")}</span>
				<header class="y2026__nav">
					<span class="y2026__logo"><span class="y2026__dot"></span>brightpath</span>
					<span class="y2026__links">Product · Solutions · Pricing</span>
					<span class="y2026__cta">Get started</span>
				</header>
				<div class="y2026__hero">
					<h1>The platform for whatever comes next.</h1>
					<p>Brightpath helps teams align, ship, and grow with clarity.</p>
					<div class="y2026__buttons">
						<span class="y2026__cta">Book a demo</span>
						<button class="y2026__ghost" type="button" data-explode>See how it's built →</button>
					</div>
				</div>
				<p class="y2026__trusted">
					Trusted by teams at <span>▬▬▬</span> <span>▬▬▬▬</span> <span>▬▬</span> <span>▬▬▬▬▬</span>
				</p>
			</section>

			<aside class="floater cookies" id="cookies" style="--depth: 6.2" aria-label="Cookie notice">
				<p>We use layers to improve your experience.</p>
				<div>
					<button type="button" data-explode>Manage layers</button>
					<button type="button" id="accept-cookies">Accept all</button>
				</div>
			</aside>
		</div>
	</div>

	<div class="controls">
		<label for="explode">layers</label>
		<input type="range" id="explode" min="0" max="100" value="0" />
		<button type="button" id="flatten" hidden>flatten</button>
	</div>
</Day>

<script>
	const stage = document.getElementById("stage") as HTMLElement;
	const stack = document.getElementById("stack") as HTMLElement;
	const slider = document.getElementById("explode") as HTMLInputElement;
	const flattenButton = document.getElementById("flatten") as HTMLButtonElement;
	const cookies = document.getElementById("cookies") as HTMLElement;
	const acceptButton = document.getElementById("accept-cookies") as HTMLButtonElement;

	const DEGREES_PER_PIXEL = 0.25;
	const MOST_TILT = 70;
	const FULL_SPREAD_AT = 40;
	const PRESET_TILT_X = -44;
	const PRESET_TILT_Y = 26;
	const DRAG_THRESHOLD = 6;
	const TWEEN_MS = 900;

	const SEPARATING_LAYERS = 5;
	const VOLUME = 0.35;
	const SOUND_STAGGER = 0.045;

	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	let tiltX = 0;
	let tiltY = 0;
	let tween = 0;
	let layersApart = 0;

	let audio: AudioContext | null = null;
	let masterVolume: GainNode | null = null;
	let noise: AudioBuffer | null = null;

	function getAudio() {
		if (!audio) {
			audio = new AudioContext();
			masterVolume = audio.createGain();
			masterVolume.gain.value = VOLUME;
			masterVolume.connect(audio.destination);
			noise = audio.createBuffer(1, Math.round(audio.sampleRate * 0.2), audio.sampleRate);
			const samples = noise.getChannelData(0);
			for (let i = 0; i < samples.length; i++) {
				samples[i] = Math.random() * 2 - 1;
			}
		}
		if (audio.state === "suspended") {
			audio.resume();
		}
		return audio;
	}

	function playNoise(
		startAt: number,
		filterType: BiquadFilterType,
		frequency: number,
		volume: number,
		seconds: number,
	) {
		const context = getAudio();
		const source = context.createBufferSource();
		source.buffer = noise;
		const filter = context.createBiquadFilter();
		filter.type = filterType;
		filter.frequency.value = frequency;
		filter.Q.value = 1.2;
		const envelope = context.createGain();
		envelope.gain.setValueAtTime(0.0001, startAt);
		envelope.gain.exponentialRampToValueAtTime(volume, startAt + 0.004);
		envelope.gain.exponentialRampToValueAtTime(0.0001, startAt + seconds);
		source
			.connect(filter)
			.connect(envelope)
			.connect(masterVolume as GainNode);
		source.start(startAt);
		source.stop(startAt + seconds + 0.02);
	}

	function playTone(startAt: number, frequency: number, volume: number, seconds: number) {
		const context = getAudio();
		const oscillator = context.createOscillator();
		oscillator.type = "sine";
		oscillator.frequency.setValueAtTime(frequency, startAt);
		oscillator.frequency.exponentialRampToValueAtTime(frequency * 0.8, startAt + seconds);
		const envelope = context.createGain();
		envelope.gain.setValueAtTime(0.0001, startAt);
		envelope.gain.exponentialRampToValueAtTime(volume, startAt + 0.005);
		envelope.gain.exponentialRampToValueAtTime(0.0001, startAt + seconds);
		oscillator.connect(envelope).connect(masterVolume as GainNode);
		oscillator.start(startAt);
		oscillator.stop(startAt + seconds + 0.02);
	}

	function playPeel(layer: number, startAt: number) {
		playNoise(startAt, "bandpass", 900 * 1.25 ** layer, 0.5, 0.09);
		playTone(startAt, 220 * 1.19 ** layer, 0.18, 0.08);
	}

	function playSettle(layer: number, startAt: number) {
		playNoise(startAt, "lowpass", 500 * 1.15 ** layer, 0.35, 0.07);
		playTone(startAt, 140 * 1.12 ** layer, 0.14, 0.06);
	}

	function countLayersApart(spread: number) {
		let count = 0;
		for (let layer = 1; layer <= SEPARATING_LAYERS; layer++) {
			if (spread >= (layer - 0.5) / SEPARATING_LAYERS) {
				count = layer;
			}
		}
		return count;
	}

	function soundLayers(spread: number) {
		const nowApart = countLayersApart(spread);
		if (nowApart === layersApart) {
			return;
		}
		const startAt = getAudio().currentTime;
		let step = 0;
		if (nowApart > layersApart) {
			for (let layer = layersApart + 1; layer <= nowApart; layer++) {
				playPeel(layer, startAt + step * SOUND_STAGGER);
				step++;
			}
		} else {
			for (let layer = layersApart; layer > nowApart; layer--) {
				playSettle(layer, startAt + step * SOUND_STAGGER);
				step++;
			}
		}
		layersApart = nowApart;
	}

	function spreadFor(x: number, y: number) {
		return Math.min(1, Math.hypot(x, y) / FULL_SPREAD_AT);
	}

	function render() {
		const spread = spreadFor(tiltX, tiltY);
		stack.style.setProperty("--tilt-x", `${tiltX}deg`);
		stack.style.setProperty("--tilt-y", `${tiltY}deg`);
		stack.style.setProperty("--spread", spread.toFixed(3));
		document.body.classList.toggle("is-flat", spread < 0.01);
		flattenButton.hidden = spread < 0.01;
		slider.value = String(Math.round(spread * 100));
		soundLayers(spread);
	}

	function clampTilt(degrees: number) {
		return Math.max(-MOST_TILT, Math.min(MOST_TILT, degrees));
	}

	function tweenTo(toX: number, toY: number) {
		cancelAnimationFrame(tween);
		if (prefersReducedMotion.matches) {
			tiltX = toX;
			tiltY = toY;
			render();
			return;
		}
		const fromX = tiltX;
		const fromY = tiltY;
		const start = performance.now();
		function step(now: number) {
			const progress = Math.min(1, (now - start) / TWEEN_MS);
			const eased = 1 - (1 - progress) ** 3;
			tiltX = fromX + (toX - fromX) * eased;
			tiltY = fromY + (toY - fromY) * eased;
			render();
			if (progress < 1) {
				tween = requestAnimationFrame(step);
			}
		}
		tween = requestAnimationFrame(step);
	}

	let pressX = 0;
	let pressY = 0;
	let startTiltX = 0;
	let startTiltY = 0;
	let pressing = false;
	let dragging = false;

	stage.addEventListener("pointerdown", (event) => {
		if (event.button !== 0) {
			return;
		}
		pressing = true;
		dragging = false;
		pressX = event.clientX;
		pressY = event.clientY;
		startTiltX = tiltX;
		startTiltY = tiltY;
	});

	stage.addEventListener("pointermove", (event) => {
		if (!pressing) {
			return;
		}
		const movedX = event.clientX - pressX;
		const movedY = event.clientY - pressY;
		if (!dragging && Math.hypot(movedX, movedY) < DRAG_THRESHOLD) {
			return;
		}
		if (!dragging) {
			dragging = true;
			cancelAnimationFrame(tween);
			stage.setPointerCapture(event.pointerId);
			document.body.classList.add("is-dragging");
		}
		tiltX = clampTilt(startTiltX - movedY * DEGREES_PER_PIXEL);
		tiltY = clampTilt(startTiltY + movedX * DEGREES_PER_PIXEL);
		render();
	});

	function endPress() {
		pressing = false;
		document.body.classList.remove("is-dragging");
	}
	stage.addEventListener("pointerup", endPress);
	stage.addEventListener("pointercancel", endPress);

	stage.addEventListener(
		"click",
		(event) => {
			if (dragging) {
				event.preventDefault();
				event.stopPropagation();
				dragging = false;
			}
		},
		true,
	);

	for (const button of document.querySelectorAll("[data-explode]")) {
		button.addEventListener("click", () => tweenTo(PRESET_TILT_X, PRESET_TILT_Y));
	}

	acceptButton.addEventListener("click", () => {
		cookies.classList.add("is-gone");
	});

	slider.addEventListener("input", () => {
		cancelAnimationFrame(tween);
		const amount = Number(slider.value) / 100;
		tiltX = PRESET_TILT_X * amount;
		tiltY = PRESET_TILT_Y * amount;
		render();
	});

	flattenButton.addEventListener("click", () => tweenTo(0, 0));

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			tweenTo(0, 0);
		}
	});
	stage.addEventListener("dblclick", () => tweenTo(0, 0));

	render();
</script>

<style is:global>
	:root {
		--accent: #ff2e93;
		--ink: #0b0b0c;
		--gap: 170px;
		--middle: 3;
	}
	html,
	body {
		margin: 0;
		block-size: 100%;
		overflow: hidden;
		background: var(--ink);
	}

	.stage {
		position: fixed;
		inset: 0;
		perspective: 2200px;
		touch-action: none;
		user-select: none;
		cursor: grab;
	}
	.is-dragging .stage {
		cursor: grabbing;
	}
	.stack {
		--spread: 0;
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transform: scale(calc(1 - 0.5 * var(--spread))) rotateX(var(--tilt-x, 0deg))
			rotateY(var(--tilt-y, 0deg));
	}
	.layer,
	.floater {
		position: absolute;
		transform: translateZ(calc((var(--depth) - var(--middle)) * var(--spread) * var(--gap)));
		backface-visibility: visible;
	}
	.layer {
		inset: 0;
		overflow: hidden;
		box-sizing: border-box;
	}
	.is-flat .stack,
	.is-flat .layer,
	.is-flat .floater {
		transform: none;
		transform-style: flat;
	}

	.tag {
		position: absolute;
		inset: 0 auto auto 0;
		z-index: 10;
		padding: 0.3em 0.6em;
		font:
			12px / 1.2 ui-monospace,
			monospace;
		color: var(--accent);
		background: var(--ink);
		opacity: var(--spread);
		pointer-events: none;
	}
	.layer {
		outline: calc(var(--spread) * 2px) solid color-mix(in srgb, var(--accent) 60%, transparent);
	}
	body:not(.is-flat) .layer:hover {
		outline-color: var(--accent);
		outline-width: 3px;
	}

	.canvas {
		background-color: #fff;
		background-image: conic-gradient(#e8e8e8 25%, #fff 0 50%, #e8e8e8 0 75%, #fff 0);
		background-size: 24px 24px;
	}
	.canvas__dust {
		position: absolute;
		inset: 45% 0 auto;
		margin: 0;
		text-align: center;
		font:
			13px ui-monospace,
			monospace;
		color: #b5b5b5;
	}
	.canvas__nap {
		position: absolute;
		right: 6%;
		bottom: 5%;
		inline-size: 78px;
		block-size: 78px;
	}
	.canvas__zzz {
		position: absolute;
		right: 60px;
		bottom: 70px;
		font:
			italic 700 15px ui-monospace,
			monospace;
		color: #6b4a2f;
		white-space: nowrap;
		animation: snooze 3s ease-in-out infinite;
	}
	@keyframes snooze {
		50% {
			translate: -6px -8px;
			opacity: 0.5;
		}
	}

	.y1997 {
		padding: 3rem 1.5rem 1.5rem;
		font:
			18px / 1.5 "Comic Sans MS",
			"Comic Sans",
			"Chalkboard SE",
			cursive;
		color: #ffff66;
		text-align: center;
		background-color: #000018;
		background-image:
			radial-gradient(1px 1px at 20px 30px, #fff, transparent),
			radial-gradient(1px 1px at 80px 120px, #fff, transparent),
			radial-gradient(2px 2px at 140px 60px, #ccf, transparent),
			radial-gradient(1px 1px at 170px 160px, #fff, transparent);
		background-size: 200px 200px;
	}
	.y1997 .link {
		text-decoration: underline;
		color: #00ffff;
	}
	.y1997__marquee {
		overflow: hidden;
		white-space: nowrap;
		color: #ff66ff;
	}
	.y1997__marquee span {
		display: inline-block;
		padding-inline-start: 100%;
		animation: marquee 14s linear infinite;
	}
	@keyframes marquee {
		to {
			translate: -100%;
		}
	}
	.y1997__title {
		margin: 0.5em 0 0;
		font:
			700 clamp(2.5rem, 9vw, 5rem) / 1 "Times New Roman",
			Times,
			serif;
		color: #ff0;
		text-shadow: 3px 3px 0 #f0f;
	}
	.y1997__under {
		display: inline-block;
		padding: 0.3em 1em;
		color: #000;
		background: repeating-linear-gradient(45deg, #fc0 0 14px, #000 14px 28px);
		font-weight: 700;
	}
	.y1997__under {
		text-shadow:
			0 0 4px #fc0,
			0 0 4px #fc0;
	}
	.y1997__rainbow {
		block-size: 6px;
		border: 0;
		background: linear-gradient(90deg, red, orange, yellow, lime, cyan, blue, violet);
	}
	.y1997__new {
		color: #f00;
		font-weight: 700;
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			visibility: hidden;
		}
	}
	.y1997__counter span {
		padding: 0 0.3em;
		font-family: ui-monospace, monospace;
		color: #0f0;
		background: #000;
		border: 2px inset #888;
		letter-spacing: 0.15em;
	}
	.y1997__small {
		font-size: 12px;
		color: #aaa;
	}

	.y2001 {
		font:
			12px / 1.45 Verdana,
			Tahoma,
			Geneva,
			sans-serif;
		color: #000;
		background: #d4d0c8;
		padding: 2.5rem 1rem 1rem;
	}
	.y2001__banner {
		padding: 0.6em 0.8em;
		font:
			700 clamp(16px, 3vw, 26px) Arial,
			Helvetica,
			sans-serif;
		color: #fff;
		background: linear-gradient(90deg, #000080, #1084d0);
	}
	.y2001__body {
		display: flex;
		gap: 0;
		border: 1px solid #808080;
		background: #fff;
	}
	.y2001__nav {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		flex: 0 0 8.5em;
		padding: 0.8em;
		background: #eeeeee;
		border-right: 1px solid #808080;
	}
	.y2001 .link {
		text-decoration: underline;
		color: #0000ee;
	}
	.y2001__main {
		padding: 0.8em 1.2em;
	}
	.y2001__main h2 {
		margin-top: 0;
		font:
			700 15px Arial,
			Helvetica,
			sans-serif;
		color: #000080;
	}
	.y2001__spacer {
		color: #bbb;
		font-size: 10px;
	}
	.y2001__small {
		font-size: 10px;
		color: #666;
	}

	.y2008 {
